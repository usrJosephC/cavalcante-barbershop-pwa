# --- Banco de dados (Supabase Postgres) ---
# No painel do Supabase: Project Settings > Database > Connection string
# DATABASE_URL usa a porta 6543 (pgbouncer / transaction pooler) - usada em runtime pela app.
# DIRECT_URL usa a porta 5432 (conexão direta) - usada pelo Prisma para rodar migrations.
DATABASE_URL="postgresql://postgres.xxxxxxxxxxxx:SUA_SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xxxxxxxxxxxx:SUA_SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# --- Autenticação do admin (barbeiro) ---
# Gere um valor aleatório forte, ex: `openssl rand -base64 32`
AUTH_SECRET="troque-este-valor-por-um-segredo-aleatorio-forte"

# --- Web Push (lembretes de agendamento) ---
# Gere o par de chaves com: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:contato@cavalcantebarbershop.com.br"

# --- Cron job de lembretes ---
# Segredo compartilhado com o Vercel Cron para autenticar a chamada em /api/cron/reminders
CRON_SECRET="troque-este-valor-por-um-segredo-aleatorio"

# --- URL pública da aplicação (usada em links de e-mail/push e metadata) ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Usado apenas pelo script de seed (prisma/seed.ts) para criar o admin inicial ---
# Não é lido pela aplicação em runtime.
SEED_ADMIN_NAME="Joseph Cavalcante"
SEED_ADMIN_EMAIL="admin@cavalcantebarbershop.com.br"
SEED_ADMIN_PASSWORD="troque-esta-senha"
